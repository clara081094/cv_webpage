# Copy to .env (same directory as docker-compose.yml) before deploying.
# docker compose reads this file automatically. Never commit .env.
#
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

POSTGRES_USER=website
POSTGRES_PASSWORD=website
POSTGRES_DB=website

# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Server only: publish the containers on localhost so the host nginx is the
# only public entry point (Docker bypasses ufw for published ports).
# DB_BIND=127.0.0.1:5433
# BACKEND_BIND=127.0.0.1:5001
# FRONTEND_BIND=127.0.0.1:8080
