# Copy to .env and adjust. Never commit .env.
FLASK_ENV=development
FLASK_APP=wsgi:app

# Postgres (docker compose maps the container's 5432 to host 5433)
DATABASE_URL=postgresql+psycopg://website:website@localhost:5433/website
TEST_DATABASE_URL=postgresql+psycopg://website:website@localhost:5433/website_test

# Secrets - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Media uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
PUBLIC_MEDIA_URL=/static/uploads

# i18n
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,en
